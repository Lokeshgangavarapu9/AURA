// Prisma Schema Configuration for AURA AI Companion OS

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User Model (Baseline)
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// User Profile Model (Single Source of Truth for Identity Details)
model UserProfile {
  id         String   @id @default(uuid())
  name       String?
  age        Int?
  occupation String?
  college    String?
  bio        String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Memory Fact Model (Structured Fact, Preference, Goal & Knowledge Storage)
model MemoryFact {
  id          String   @id @default(uuid())
  category    String   // 'fact' | 'preference' | 'goal' | 'relationship' | 'knowledge'
  key         String
  value       String
  confidence  Float    @default(1.0)
  importance  Int      @default(5)
  frequency   Int      @default(1)
  lastUsedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Reflection Model (Meta-Summaries & Long-term Insights)
model Reflection {
  id        String   @id @default(uuid())
  summary   String
  sentiment String?
  createdAt DateTime @default(now())
}

// Conversation Session Model (Session Metadata & History Threading ONLY)
model ConversationSession {
  id                String              @id @default(uuid())
  title             String?             @default("New Conversation")
  currentTopic      String?             @default("General")
  messageCount      Int                 @default(0)
  isPinned          Boolean             @default(false)
  lastInteractionAt DateTime            @default(now())
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  messages          ChatMessageRecord[]
}

// Chat Message Record Model (Individual Message Log per Session ONLY)
model ChatMessageRecord {
  id        String              @id @default(uuid())
  sessionId String
  sender    String              // 'user' | 'ai'
  text      String
  emotion   String?             @default("neutral")
  topic     String?             @default("General")
  createdAt DateTime            @default(now())
  session   ConversationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

// App Settings Model (Single Source of Truth for Device & Engine Preferences)
model Settings {
  id                      String   @id @default("default")
  // Appearance
  theme                   String   @default("obsidian")
  accentColor             String   @default("#3b82f6")
  avatarEyeColor          String   @default("#4338ca")
  avatarGlowColor         String   @default("#3b82f6")
  fontSize                String   @default("medium")
  animationsEnabled       Boolean  @default(true)
  soundFxEnabled          Boolean  @default(true)
  // Memory
  memoryEnabled           Boolean  @default(true)
  autoSave                Boolean  @default(true)
  longTermMemory          Boolean  @default(true)
  sensitiveMemory         Boolean  @default(false)
  reviewBeforeSave        Boolean  @default(false)
  // AI Companion
  responseLength          String   @default("medium")
  personality             String   @default("aura-gentle")
  creativity              Int      @default(70)
  empathy                 Int      @default(90)
  conversationStyle       String   @default("empathic")
  // Voice
  selectedMicrophone      String   @default("default")
  selectedSpeaker         String   @default("default")
  noiseSuppression        Boolean  @default(true)
  echoCancellation        Boolean  @default(true)
  // Vision
  selectedCamera          String   @default("default")
  eyeTracking             Boolean  @default(true)
  gestureTracking         Boolean  @default(false)
  visionEnabled           Boolean  @default(true)
  cameraSensitivity       Int      @default(80)
  // Notifications
  desktopNotifications    Boolean  @default(true)
  reminderSettings        String   @default("daily")
  notificationSound       Boolean  @default(true)
  // Privacy
  cameraPermission        Boolean  @default(true)
  microphonePermission     Boolean  @default(true)
  // Connectors
  connectorsEnabled       String   @default("[]") // JSON string list of enabled connectors
}
